
func waterfall_cave_msg()
    sign_start;
    cam_look_npc ENTITY_ID_SUBJECT;
    say "
        Good job finding this place!
        
        ...Uh. I don't really have any treasure to give you. 
        
        You can keep any nuts you find around here though.

        If you are looking for a memory module, try a different cave.
    ";

    sign_end;
end